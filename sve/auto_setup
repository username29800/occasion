# NOTE: From sve-occasion-2026.4, auto-setup and guided-setup uses no-docs version of config generator.
#       For beginners, it is recommended to switch to the guided version using:
#       1. Open newdb_interactive
#       2. Replace "newdb_nodocs" with "newdb"
#       3. Open newconf_interactive
#       4. Replace "newconf_nodocs" with "newconf"


# Global config
config_name="config_name"
key_name="key_name"
dotssh="$HOME/.ssh"
homedir="$HOME"
client_id="here.example"

# Instance config
instance_name="instance_name"
instance_id="there.example"
instance_port="22"
instance_user="user"

# Runner config
create_config="y"
create_instance="y"

# Usually you don't have to modify this section
instance_dotssh="/home/${instance_user}/.ssh"
instance_home="/home/${instance_user}"

# Runner

echo "$create_config
$config_name

$dotssh

$key_name

$client_id

$homedir
n
" | sh guided_setup

echo "n
$create_instance
$config_name
$instance_name

$instance_id
$instance_port
$instance_user

$instance_dotssh

$instance_home
" | sh guided_setup

pp="Occasion Auto-setup:"
echo "$pp Congratulations. You're good to go."
echo "$pp Test connection with:"
echo "$pp $ sh build/ocsn_con ${config_name} ${instance_name}"
echo "$pp "
echo "$pp Then, register your ssh key with:"
echo "$pp $ sh build/ocaa_run ${config_name} ${instance_name}"
echo "$pp "
echo "$pp It is recommended to install Occasion UX"
echo "$pp (extended path and configs for Occasion utilities)"
echo "$pp $ sh build/cfgmini ${config_name} ${instance_name}"
echo "$pp "
echo "$pp To install Occasion UX on remote:"
echo "$pp 1. Navigate to 'r_exec_${instance_name}' in ${config_name}"
echo "$pp 2. Follow the instruction provided in comments"
echo "$pp "
echo "$pp NOTE: You don't have to install Occasion UX"
echo "$pp       if you have a working installation"
echo "$pp       Also check out .profile for additional configuration"
echo "$pp "
echo "$pp Good luck, have fun! :)"
